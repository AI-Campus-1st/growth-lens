# ===== 비밀값 / 환경변수 =====
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# ===== 데이터 (원천·중간·가공 데이터는 저장소에 커밋하지 않음) =====
data/raw/*
data/interim/*
data/processed/*
data/knowledge/*
!data/**/.gitkeep
# data/sample/ 은 재배포가 허용된 소량 샘플만 커밋 (data_sources.md 의 라이선스 확인 후)
*.parquet
*.feather
*.h5
*.hdf5
*.zip
*.gz
*.tar
*.7z
*.db
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal

# ===== 모델 산출물 / 벡터DB =====
models/*
!models/.gitkeep
*.pkl
*.joblib
*.onnx
*.pt
*.ckpt
chroma/
faiss_index/
vectorstore/
.lancedb/

# ===== 산출물 (승인된 보고서만 별도 커밋) =====
outputs/figures/*
outputs/metrics/*
outputs/reports/*
!outputs/**/.gitkeep

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ===== Streamlit =====
.streamlit/secrets.toml

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
