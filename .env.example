# GrowthLens 환경변수 예시 파일
# 이 파일을 복사해 .env 를 만들고 각자 발급받은 값을 입력하세요.
# .env 는 절대 커밋하지 않습니다. (.gitignore 에 등록됨)

# --- Naver Developers (DataLab 검색어 트렌드 / 쇼핑인사이트) ---
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# --- Naver 검색광고 API (키워드 도구) ---
NAVER_SEARCHAD_API_KEY=your_searchad_api_key
NAVER_SEARCHAD_SECRET_KEY=your_searchad_secret_key
NAVER_SEARCHAD_CUSTOMER_ID=your_customer_id

# --- 공공데이터 ---
KOSIS_API_KEY=your_kosis_api_key
DATA_GO_KR_SERVICE_KEY=your_data_go_kr_service_key   # 기상청·공휴일 API 등

# --- LLM / 임베딩 (제공사 미정: 결정 후 변수명 확정) ---
LLM_PROVIDER=undecided
LLM_API_KEY=your_llm_api_key
EMBEDDING_MODEL=undecided

# --- 데이터베이스 (미정) ---
DATABASE_URL=postgresql://user:password@localhost:5432/growthlens
